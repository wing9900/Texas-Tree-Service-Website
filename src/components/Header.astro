---
/**
 * HEADER — phone number is tap-to-call and visible from the first pixel
 * (Rule 21). Nav is CSS-only (checkbox toggle), zero JavaScript; all nav
 * links exist in the HTML for crawlers regardless of toggle state.
 * Remember: nav links are for USERS — authority flows through the
 * editorial links in page content (Rule 16), not this menu.
 */
import { getCollection } from 'astro:content';
import { business as b, telHref } from '../config/business';

// "Service Areas" is a permanent nav item: coverage is the second thing
// every caller asks after price, so it never gates on content existing.
// It points at /service-areas/, which indexes a page per town once the
// locations collection has entries and states config coverage until then
// (the hub noindexes itself while empty, so it can't rank as a stub).
// Nav items for proof pages gate on their proof existing: projects on
// gallery entries, reviews on a live GBP rating. They reappear on their
// own the day the data is real — nothing to remember at fill-in time.
const hasProjects = (await getCollection('projects')).length > 0;
const hasRating = b.gbp.ratingValue > 0 && b.gbp.reviewCount > 0;
---

<header class="site-header">
  <div class="container">
    <div class="site-header__bar">
      <a class="site-header__brand" href="/" aria-label={`${b.name}, back to homepage`}>
        <img class="site-header__logo" src="/images/conroe-tree-co-logo.webp" alt="" width="241" height="248" />
        <span class="site-header__wordmark">
          {(b.brandLockup ?? [b.name]).map((line) => <span>{line}</span>)}
        </span>
      </a>
      <div class="site-header__actions">
        <a class="site-header__estimate" href="/appointment/">Free Estimate</a>
        <a class="site-header__phone" href={telHref} aria-label={`Call ${b.name}`}>
          <span class="site-header__phone-short">Call</span>
          <span class="site-header__phone-full">Call Now</span>
        </a>
      </div>
      <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Toggle navigation menu" />
      <label for="nav-toggle" class="nav-toggle-label"><span class="nav-icon nav-icon--open" aria-hidden="true">☰</span><span class="nav-icon nav-icon--close" aria-hidden="true">✕</span> Menu</label>
      <label for="nav-toggle" class="nav-scrim" aria-hidden="true"></label>

      <nav class="site-nav" aria-label="Main">
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/services/">Services</a></li>
          {/* Directly after Services: what we do, then where we do it —
              the pair a visitor scans together before anything else. */}
          <li><a href="/service-areas/">Service Areas</a></li>
          {hasProjects && <li><a href="/projects/">Recent Work</a></li>}
          {hasRating && <li><a href="/testimonials/">Reviews</a></li>}
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
        {/* Menu CTAs — phone overlay only (hidden ≥48rem, where the header
            bar already shows both). Plain links: tel: + /appointment/,
            zero JS. Every "free estimate" BUTTON on the site points at the
            booking calendar, not /contact/: the estimate starts with a
            time on the calendar, and /contact/ stays the destination for
            "send us a message" wording and the in-content editorial links.
            Keep the two straight when adding CTAs. */}
        <div class="site-nav__cta">
          <a class="btn btn--primary" href={telHref}>Call Now</a>
          <a class="btn btn--outline" href="/appointment/">Get a Free Estimate</a>
        </div>
      </nav>
    </div>
  </div>
</header>
