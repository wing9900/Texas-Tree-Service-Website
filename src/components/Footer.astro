---
/**
 * FOOTER — NAP repeated from config (always consistent by construction),
 * hours matching the GBP, quick links. Footer links don't pass authority
 * (Rule 16) — they're user convenience only.
 */
import { getCollection } from 'astro:content';
import { business as b, cityState, telHref } from '../config/business';
const year = new Date().getFullYear();

// Proof-page links gate on their proof existing (matches Header.astro):
// projects on gallery entries, reviews on a live GBP rating.
const hasProjects = (await getCollection('projects')).length > 0;
const hasRating = b.gbp.ratingValue > 0 && b.gbp.reviewCount > 0;

// Collapse only CONTIGUOUS day runs (matches MapNAP.astro) so exception
// days render as "Mon, Wed–Fri" instead of a contradictory "Mon–Fri".
const WEEK = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const dayLabel = (days: readonly string[]) => {
  const runs: string[][] = [];
  for (const d of days) {
    const run = runs[runs.length - 1];
    if (run && WEEK.indexOf(d) === WEEK.indexOf(run[run.length - 1]) + 1) run.push(d);
    else runs.push([d]);
  }
  return runs
    .map((r) => (r.length > 1 ? `${r[0].slice(0, 3)}–${r[r.length - 1].slice(0, 3)}` : r[0].slice(0, 3)))
    .join(', ');
};
// 00:00–23:59 is the schema.org open-all-day convention — show it in words.
const timeLabel = (h: { opens: string; closes: string }) =>
  h.opens === '00:00' && h.closes === '23:59' ? 'Open 24 hours' : `${h.opens}–${h.closes}`;
// Days in no hours entry are closed days; render them so the week is complete.
const covered = new Set(b.hours.flatMap((h) => h.days as readonly string[]));
const closedDays = WEEK.filter((d) => !covered.has(d));

// Social/citation profiles render FROM business.sameAs, so the footer can
// never advertise a profile the LocalBusiness schema doesn't also claim —
// same single-source rule that keeps NAP from drifting. Brand glyphs are
// inlined (simple-icons, CC0) because the site makes zero external
// requests; the Yelp mark is the burst only, with the ® trimmed off since
// it renders as a speck of noise at this size. A sameAs host with no glyph
// here still links, labelled by hostname, rather than disappearing.
//
// Each mark is a brand-colored disc with a white glyph, so the two read as
// one set. They get there differently: the Facebook path IS the disc with
// the f knocked out of it, so the white sits BEHIND and the path carries
// the blue. Yelp's path is a plain glyph, so the disc carries the red and
// the path is white — and the burst needs scaling down, since it fills its
// viewBox edge to edge and would otherwise touch the circle.
const SOCIAL_ICONS: Record<string, { label: string; disc: string; fill: string; transform?: string }> = {
  'facebook.com': {
    label: 'Facebook',
    disc: '#fff',
    fill: '#1877f2',
    path: 'M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z',
  },
  'yelp.com': {
    label: 'Yelp',
    disc: '#ff1a1a',
    fill: '#fff',
    // Sized and centered by measurement, not by eye. 0.76 is where the
    // burst's ink area matches the white f inside the Facebook disc
    // (113.8 sq units) — at 0.6 it carried only 61% of the f's weight and
    // read as the smaller of the two. The same 0.76 keeps its furthest
    // point at 9.6 of the disc's 12 radius, so it still has a clear margin.
    // Pivot is the burst's CENTER OF MASS (10.97, 12.51), not its bounding
    // box (11, 12): the mark is bottom-heavy, so a bbox pivot sits the ink
    // low in the disc.
    transform: 'translate(12 12) scale(.76) translate(-10.97 -12.51)',
    path: 'm7.6885 15.1415-3.6715.8483c-.3769.0871-.755.183-1.1452.155-.2611-.0188-.5122-.0414-.7606-.213a1.179 1.179 0 0 1-.331-.3594c-.3486-.5519-.3656-1.3661-.3697-2.0004a6.2874 6.2874 0 0 1 .3314-2.0642 1.857 1.857 0 0 1 .1073-.2474 2.3426 2.3426 0 0 1 .1255-.2165 2.4572 2.4572 0 0 1 .1563-.1975 1.1736 1.1736 0 0 1 .399-.2831 1.082 1.082 0 0 1 .4592-.0837c.2355.0016.5139.052.91.1734.0555.0191.1237.0382.1856.0572.3277.1013.7048.2404 1.1499.3987.6863.2404 1.3663.487 2.0463.7397l1.2117.4423c.2217.0807.4363.18.6412.297.174.0984.3273.2298.4512.387a1.217 1.217 0 0 1 .192.4309 1.2205 1.2205 0 0 1-.872 1.4522c-.0468.0151-.0852.0239-.1085.0293l-1.105.2553-.0031-.001zM18.8208 7.565a1.8506 1.8506 0 0 0-.2042-.1754 2.4082 2.4082 0 0 0-.2077-.1394 2.3607 2.3607 0 0 0-.2269-.109 1.1705 1.1705 0 0 0-.482-.0796 1.0862 1.0862 0 0 0-.4498.1263c-.2107.1048-.4388.2732-.742.5551-.042.0417-.0947.0886-.142.133-.2502.2351-.5286.5252-.8599.863a114.6363 114.6363 0 0 0-1.5166 1.5629l-.8962.9293a4.1897 4.1897 0 0 0-.4466.5483 1.541 1.541 0 0 0-.2364.5459 1.2199 1.2199 0 0 0 .0107.4518l.0046.02a1.218 1.218 0 0 0 1.4184.923 1.162 1.162 0 0 0 .1105-.0213l4.7781-1.104c.3766-.087.7587-.1667 1.097-.3631.2269-.1316.4428-.262.5909-.5252a1.1793 1.1793 0 0 0 .1405-.4683c.0733-.6512-.2668-1.3908-.5403-1.963a6.2792 6.2792 0 0 0-1.2001-1.7103zM8.9703.0754a8.6724 8.6724 0 0 0-.83.1564c-.2754.066-.548.1383-.8146.2236-.868.2844-2.0884.8063-2.295 1.8065-.1165.5655.1595 1.1439.3737 1.66.2595.6254.614 1.1889.9373 1.7777.8543 1.5545 1.7245 3.0993 2.5922 4.6457.259.4617.5416 1.0464 1.043 1.2856a1.058 1.058 0 0 0 .1013.0383c.2248.0851.4699.1016.7041.0471a4.3015 4.3015 0 0 0 .0418-.0097 1.2136 1.2136 0 0 0 .5658-.3397 1.1033 1.1033 0 0 0 .079-.0822c.3463-.435.3454-1.0833.3764-1.6134.1042-1.771.2139-3.5423.3009-5.3142.0332-.6712.1055-1.3333.0655-2.0096-.0328-.5579-.0368-1.1984-.3891-1.6563-.6218-.8073-1.9476-.741-2.8523-.6158zm2.084 15.9505a1.1053 1.1053 0 0 0-1.2306-.4145 1.1398 1.1398 0 0 0-.1526.0633 1.4806 1.4806 0 0 0-.2171.1354c-.1992.1475-.3668.3392-.5196.5315-.0386.049-.074.1143-.12.1562l-.7686 1.0573a113.9168 113.9168 0 0 0-1.2913 1.789c-.278.3895-.5184.7184-.7083 1.0094-.036.0547-.0734.116-.1075.1647-.2277.3522-.3566.6092-.4228.8381a1.0945 1.0945 0 0 0-.046.4721c.0211.1655.0768.3246.1635.467.046.0715.0957.1406.1487.207a2.334 2.334 0 0 0 .1754.1825 1.843 1.843 0 0 0 .2108.1732c.5304.369 1.1112.6342 1.722.8391a6.0958 6.0958 0 0 0 1.5716.3004c.091.0046.1821.0025.2728-.006a2.3878 2.3878 0 0 0 .2506-.0351 2.3862 2.3862 0 0 0 .2447-.071 1.1927 1.1927 0 0 0 .4175-.2658c.1127-.113.1994-.249.2541-.3989.0889-.2214.1473-.5026.1857-.92.0034-.0593.0118-.1305.0177-.1958.0304-.3463.0443-.7531.0666-1.2315.0375-.7357.067-1.4681.0903-2.2026 0 0 .0495-1.3053.0494-1.306.0113-.3008.002-.6342-.0814-.9336a1.396 1.396 0 0 0-.1756-.4054zm8.6754 2.0439c-.1605-.176-.3878-.3514-.7462-.5682-.0518-.0288-.1124-.0674-.1684-.1009-.2985-.1795-.658-.3684-1.078-.5965a120.7615 120.7615 0 0 0-1.9427-1.042l-1.1515-.6107c-.0597-.0175-.1203-.0607-.1766-.0878-.2212-.1058-.4558-.2045-.6992-.2498a1.4915 1.4915 0 0 0-.2545-.0265 1.1527 1.1527 0 0 0-.1648.01 1.1077 1.1077 0 0 0-.9227.9133 1.4186 1.4186 0 0 0 .0159.439c.0563.3065.1932.6096.3346.875l.615 1.1526c.3422.65.6884 1.2963 1.0435 1.9406.229.4202.4196.7799.5982 1.078.0338.056.0721.1163.1011.1682.2173.3584.392.584.569.7458.1146.1107.252.195.4026.247.1583.0525.326.071.4919.0546a2.368 2.368 0 0 0 .251-.0435c.0817-.022.1622-.048.241-.0784a1.863 1.863 0 0 0 .2475-.1143 6.1018 6.1018 0 0 0 1.2818-.9597c.4596-.4522.8659-.9454 1.182-1.51.044-.08.0819-.163.1138-.2483a2.49 2.49 0 0 0 .0773-.2411c.0186-.083.033-.1669.0429-.2513a1.188 1.188 0 0 0-.0565-.491 1.0933 1.0933 0 0 0-.248-.4041z',
  },
};
const socialLinks = b.sameAs.map((href) => {
  const host = new URL(href).hostname.replace(/^www\./, '');
  return { href, ...(SOCIAL_ICONS[host] ?? { label: host, disc: '', fill: '', path: '' }) };
});
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div>
        {/* [PENDING — Conroe Tree Co. logo. Restore the
            <img class="site-footer__logo" …> line when the asset exists.] */}
        <h3 class="site-footer__name">{b.name}</h3>
        <address class="nap-block">
          {b.address.street && <Fragment>{b.address.street}<br /></Fragment>}
          {b.address.city}, {b.address.stateAbbr} {b.address.zip}<br />
          <a href={telHref}>{b.phoneDisplay}</a><br />
          <a href={`mailto:${b.legal.email}`}>{b.legal.email}</a>
        </address>
        {socialLinks.length > 0 && (
          <ul class="site-footer__social">
            {socialLinks.map((s) => (
              <li>
                {s.path ? (
                  <a class="site-footer__social-icon" href={s.href} rel="noopener" aria-label={s.label}>
                    <svg viewBox="0 0 24 24" width="32" height="32" aria-hidden="true">
                      <circle cx="12" cy="12" r="12" fill={s.disc} />
                      <path d={s.path} fill={s.fill} transform={s.transform} />
                    </svg>
                  </a>
                ) : (
                  <a href={s.href} rel="noopener">{s.label}</a>
                )}
              </li>
            ))}
          </ul>
        )}
      </div>

      <div>
        <h3>Hours</h3>
        <ul class="hours-list">
          {b.hours.map((h) => (
            <li><span>{dayLabel(h.days)}</span><span>{timeLabel(h)}</span></li>
          ))}
          {closedDays.length > 0 && (
            <li><span>{dayLabel(closedDays)}</span><span>Closed</span></li>
          )}
        </ul>
      </div>

      <div>
        <h3>Quick Links</h3>
        <ul>
          <li><a href="/services/">All Services</a></li>
          <li><a href="/locations/">Areas We Serve</a></li>
          {hasProjects && <li><a href="/projects/">Recent Work</a></li>}
          {hasRating && <li><a href="/testimonials/">Customer Reviews</a></li>}
          <li><a href="/about/">About Us</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer__legal">
      {/* Policy links live in the sitewide footer, not just the Quick Links
          column, because the toll-free SMS verification reviewer checks
          that both are reachable from any page (rejection code 30493). */}
      <p class="site-footer__policy-links">
        <a href="/privacy-policy/">Privacy Policy</a>
        <span aria-hidden="true"> · </span>
        <a href="/terms-and-conditions/">Terms &amp; Conditions</a>
        <span aria-hidden="true"> · </span>
        <a href="/terms-and-conditions/#sms-terms">SMS Terms</a>
      </p>
      <p>© {year} {b.name} · Serving {cityState} and surrounding areas</p>
    </div>
  </div>
</footer>
