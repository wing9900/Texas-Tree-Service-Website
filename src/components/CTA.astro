---
/**
 * CTA BAND — closes every page with the fastest path to a call (Rule 21).
 */
import { business as b, telHref } from '../config/business';

interface Props {
  heading?: string;
  sub?: string;
}
const {
  heading = `Ready to Get Started in ${b.address.city}?`,
  // Describes what the two buttons below actually do. The second one books
  // a time on the calendar, so the old "send your details and we'll get
  // right back to you" (written when it pointed at /contact/) would now
  // promise the wrong thing.
  sub = 'Call or text now for a free estimate, or pick a time online and we\'ll come take a look.',
} = Astro.props;
---

<section class="section cta-band">
  <div class="container">
    <h2>{heading}</h2>
    <p>{sub}</p>
    <div class="cta-band__actions">
      <a class="btn btn--primary" href={telHref}>Call Now</a>
      {/* Booking calendar, not /contact/ — see the note in Header.astro. */}
      <a class="btn btn--outline" href="/appointment/">Get a Free Estimate</a>
    </div>
  </div>
</section>
