---
/**
 * HERO — STATIC only (Rule 21: no animated/rotating heroes; they bounce).
 * H1 + subheadline + primary CTA + tap-to-call phone are all visible
 * without scrolling on a phone. The H1 is the largest text on the page
 * (CSS guarantees it) — Google infers the primary heading from size.
 *
 * IMAGE FILL-IN STEP: swap the gradient for the single best real photo of
 * the core offering (background-image or <img> with descriptive filename
 * + specific alt text, compressed WebP — Rule 26). Never clickable
 * unless labeled. No stock, no AI imagery for local proof (Rule 29).
 */
import { telHref } from '../config/business';
import GoogleRating from './GoogleRating.astro';

interface HeroImage {
  src: string;
  srcset?: string;
  mobileSrc?: string; // art-directed portrait crop for phones
  alt: string;
  width: number;
  height: number;
}
interface Props {
  eyebrow?: string;
  h1: string;
  benefits?: ReadonlyArray<string>;
  ctaLabel?: string;
  ctaHref?: string;
  image?: HeroImage; // real job photo (Rule 21/26): falls back to gradient when absent
}
// ctaHref defaults to the booking calendar, not /contact/: a "free
// estimate" button starts by putting a time on the calendar. Pages that
// want the written-request form instead pass ctaHref explicitly.
const { eyebrow, h1, benefits = [], ctaLabel = 'Get a Free Estimate', ctaHref = '/appointment/', image } = Astro.props;
// Optional `form` slot: when a page passes one (homepage only, today),
// the hero becomes a two-column split on desktop -- copy/CTA left, the
// form visible in the first screen, right -- instead of the usual
// single centred column. See the .hero--split rules in global.css.
const hasForm = Astro.slots.has('form');
const heroClass = ['hero', image && 'hero--photo', hasForm && 'hero--split'].filter(Boolean).join(' ');
---

<section class={heroClass}>
  {image && (
    <picture>
      {image.mobileSrc && (
        <source media="(max-width: 47.99rem)" srcset={image.mobileSrc} width="816" height="1020" />
      )}
      <img
        class="hero__img"
        src={image.src}
        srcset={image.srcset}
        sizes="100vw"
        alt={image.alt}
        width={image.width}
        height={image.height}
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  )}
  <div class="container">
    <div class="hero__text">
      {eyebrow && <p class="hero__eyebrow">{eyebrow}</p>}
      <h1>{h1}</h1>
      {benefits.length > 0 && (
        <p class="hero__benefits">
          {benefits.map((item) => <span>{item}</span>)}
        </p>
      )}
      <GoogleRating tone="light" size="lg" class="hero__rating" />
      <div class="hero__cta">
        <a class="btn btn--primary" href={telHref}>Call Now</a>
        <a class="btn btn--outline" href={ctaHref}>{ctaLabel}</a>
      </div>
    </div>
    {hasForm && (
      <div class="hero__form-panel">
        <slot name="form" />
      </div>
    )}
  </div>
</section>
