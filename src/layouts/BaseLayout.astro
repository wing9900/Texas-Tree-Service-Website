---
/**
 * BASE LAYOUT — wraps every page.
 * Enforces: unique <title> + meta description (required props — a page
 * cannot build without them), canonical URL, LocalBusiness schema
 * site-wide (Rule 27), header, footer, sticky mobile call bar.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LocalBusinessSchema from '../components/schema/LocalBusinessSchema.astro';
import { business } from '../config/business';

interface Props {
  title: string;        // full title tag — front-load the keyword (Rule 17)
  description: string;  // 150–160 char hand-written ad copy (Rule 20)
  noindex?: boolean;    // used only by empty scaffold pages (locations hub pre-Phase-2)
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Mobile-first: correct viewport is non-negotiable -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Stops iOS Safari from adopting the amber call bar's color into its
         (sometimes very tall) toolbar background. Keep in sync with the
         page background token (--c-bg) when re-skinning. -->
    <meta name="theme-color" content="#f7f5ee" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex' : 'max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={business.name} />
    {business.seo.ogImage && <meta property="og:image" content={new URL(business.seo.ogImage, Astro.site).href} />}
    {business.seo.ogImage && <meta name="twitter:card" content="summary_large_image" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <LocalBusinessSchema />
    <link rel="preload" href="/fonts/BarlowCondensed-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Barlow-Regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    {/* page-home scopes the homepage-only centred composition; every
        other page reads left-aligned (heroes stay centred via .hero). */}
    <main id="main" class={Astro.url.pathname === '/' ? 'page-home' : undefined}>
      <slot />
    </main>
    <Footer />
    {/* GHL (LeadConnector) chat widget -- floats site-wide, every page,
        via this shared layout. Loader is self-contained: it injects its
        own launcher bubble and panel, nothing else here to wire up. */}
    <script
      src="https://widgets.leadconnectorhq.com/loader.js"
      data-resources-url="https://widgets.leadconnectorhq.com/chat-widget/loader.js"
      data-widget-id="6a966412ae1cc8254ada5874"
      is:inline
    ></script>
    <!--
      Scroll restoration override. The browser restores the previous scroll
      offset on back/forward and sometimes on same-origin navigations, so
      arriving at the homepage after scrolling down another page could land
      the viewport mid-hero and expose the section below it.
      This renders NOTHING and is never parsed by crawlers as content, so
      the zero-JS-for-rendering rule is unaffected: the page is fully
      readable and identical with JavaScript disabled.
    -->
    <script is:inline>
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      // behavior:'instant' bypasses the html { scroll-behavior: smooth }
      // CSS, which otherwise ANIMATES this reset on back/forward and made
      // page landings look jumpy on phones.
      window.addEventListener('pageshow', function () {
        window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
      });
    </script>
  </body>
</html>
