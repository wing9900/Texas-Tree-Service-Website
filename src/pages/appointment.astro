---
/**
 * APPOINTMENT PAGE. One job: get a time on the calendar.
 *
 * This is the URL that goes out in texts, so it carries the share card
 * (see `social` below) and stays deliberately sparse. The page is the
 * calendar plus one fallback line; a second CTA would only split the click.
 *
 * Division of labour with /contact/: this page books a slot, /contact/
 * takes a written request and shows the map + hours. Neither should grow
 * the other's job, one clear next step per page (Rule 16).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { business as b, cityState, telHref } from '../config/business';

const title = `Book a Free Tree Service Estimate | ${b.name}`;
const description = `Choose a time that works for you and we'll come look at the work in ${cityState}, then give you a free estimate in writing. No obligation to book the work.`;

/**
 * Share card for THIS PAGE ONLY (og: + twitter:), passed through
 * BaseLayout's `social` prop, because meta tags have to land in <head> and
 * anything rendered from the slot below ends up in <body> where scrapers
 * ignore it. Reads as an invitation because this link gets texted; the
 * `title`/`description` above still drive <title> and meta description
 * untouched, so nothing here can move search rankings.
 */
const social = {
  title: 'Book Your Free Appointment',
  url: 'https://www.conroetreeco.com/appointment/',
  /**
   * VERSIONED ON PURPOSE. Scrapers (iMessage, Facebook, the GHL preview)
   * cache a card image against its URL, so re-uploading different bytes to
   * the same filename leaves everyone still being served the old picture.
   * A filename nothing has ever fetched cannot come from a cache.
   * Changing the artwork again means bumping to -v3, not overwriting this.
   * The unversioned estimate-preview.jpg stays in public/ on purpose: links
   * already sent point a scraper at it, and a 404 there would show a card
   * with no image at all.
   */
  image: 'https://www.conroetreeco.com/images/estimate-preview-v2.jpg',
};
---

<BaseLayout title={title} description={description} social={social}>
  <section class="hero">
    <div class="container">
      <h1>Book Your Free Estimate</h1>
      <p class="hero__sub">
        Choose a time below that works for you. We come out, look at the work,
        and give you a free estimate in writing, with no obligation to book.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {/* GHL (LeadConnector) booking calendar, the whole point of the page,
          so it gets its own centred column instead of sharing a .split.
          Same auto-height contract as every other LeadConnector embed:
          form_embed.js writes the widget's real height onto
          iframe.style.height, so the wrapper is `height: auto` and the CSS
          height is only the pre-load placeholder. */}
      <div class="embed-col embed-col--wide">
        <div class="booking-embed">
          <iframe
            src="https://api.leadconnectorhq.com/widget/booking/6xy0znQhsIGbBYFRhAqR"
            allow="payment"
            scrolling="no"
            style="width:100%;border:none;overflow:hidden;border-radius:8px"
            id="6xy0znQhsIGbBYFRhAqR_1790200366596"
            title="Book an appointment"
          ></iframe>
        </div>
      </div>
      {/* Sits inside the calendar's own section so the gap above it is the
          normal paragraph rhythm, not a full section break. The three
          reassurance cards that used to follow were removed at the owner's
          request; nothing else should be added under the calendar without
          re-checking that spacing. */}
      <p class="booking-alt">
        Rather not wait for an appointment? <a href={telHref}>Call {b.phoneDisplay}</a>
        and talk to a real person, or <a href="/contact/">send your details</a> and
        we will get right back to you.
      </p>
    </div>
    <script is:inline src="https://link.msgsndr.com/js/form_embed.js"></script>
  </section>
</BaseLayout>
