---
/**
 * CONTACT PAGE, phone-first (Rule 21: primary CTA = fastest path to a
 * call). Form has the MINIMUM possible fields (Rule 13) and is a
 * placeholder shell: wire the action/embed to the GHL form + pipeline
 * per business at fill-in time. Quote submissions auto-forward per the
 * lead-routing setup.
 *
 * The booking calendar used to sit beside the form here; it now has its
 * own page at /appointment/, which is the link that goes out in texts.
 * This page is the written-request path: call, or send details and get a
 * callback. It links to the calendar rather than embedding it, so the two
 * pages never compete for the same click.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MapNAP from '../components/MapNAP.astro';
import { business as b, cityState, telHref } from '../config/business';

const title = `Contact ${b.name} | ${b.primaryCategory} in ${cityState}`;
const description = `Call ${b.name} or send a quick request online. Free estimates for tree removal, trimming, stump grinding, and storm cleanup in ${cityState}.`;
---

<BaseLayout title={title} description={description}>
  <section class="hero">
    <div class="container">
      <h1>Get a Fast, Free Estimate in {b.address.city}</h1>
      <p class="hero__sub">Call and talk to a real person, or send your details below and we will get right back to you. Either way the estimate is free and the price is in writing before any work starts.</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href={telHref}>Call Now</a>
        <a class="btn btn--outline" href="/appointment/">Book a Time Online</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {/* GHL (LeadConnector) quote form. Now the section's only element, so
          it gets a centred, capped column rather than a half-width .split
          cell -- a lone form stretched across 1240px reads as a wall of
          inputs on a desktop monitor.
          No `height:100%` on the iframe and no fixed height on the wrapper:
          form_embed.js writes the loaded form's real height onto
          iframe.style.height, and the auto-height wrapper hugs it. A
          taller/shorter form in GHL then updates the page by itself --
          nothing to touch here. */}
      <div class="embed-col">
        <div class="quote-form-embed">
          <iframe
            src="https://api.leadconnectorhq.com/widget/form/lVpPEmDHvnyLuJHiyCIS"
            style="width:100%;border:none;border-radius:8px"
            id="inline-lVpPEmDHvnyLuJHiyCIS"
            data-layout="{'id':'INLINE'}"
            data-trigger-type="alwaysShow"
            data-trigger-value=""
            data-activation-type="alwaysActivated"
            data-activation-value=""
            data-deactivation-type="neverDeactivate"
            data-deactivation-value=""
            data-form-name="Form 0"
            data-height="1024"
            data-layout-iframe-id="inline-lVpPEmDHvnyLuJHiyCIS"
            data-form-id="lVpPEmDHvnyLuJHiyCIS"
            data-cookie-consent="true"
            data-cookie-consent-provider="auto"
            title="Form 0"
          ></iframe>
        </div>
      </div>
      <p class="booking-alt">
        Rather pick your own time? <a href="/appointment/">Book a free
        appointment online</a> and choose a slot that fits your schedule.
      </p>
    </div>
    <script is:inline src="https://link.msgsndr.com/js/form_embed.js"></script>
  </section>

  <MapNAP />
</BaseLayout>
