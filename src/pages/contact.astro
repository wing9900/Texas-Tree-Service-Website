---
/**
 * CONTACT PAGE, phone-first (Rule 21: primary CTA = fastest path to a
 * call). Form has the MINIMUM possible fields (Rule 13) and is a
 * placeholder shell: wire the action/embed to the GHL form + pipeline
 * per business at fill-in time. Quote submissions auto-forward per the
 * lead-routing setup.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MapNAP from '../components/MapNAP.astro';
import { business as b, cityState, telHref } from '../config/business';

const title = `Contact ${b.name} | ${b.primaryCategory} in ${cityState}`;
const description = `Call ${b.name} at ${b.phoneDisplay} or send a quick request online. Free estimates for tree removal, trimming, stump grinding, and storm cleanup in ${cityState}.`;
---

<BaseLayout title={title} description={description}>
  <section class="hero">
    <div class="container">
      <h1>Get a Fast, Free Estimate in {b.address.city}</h1>
      <p class="hero__sub">The quickest way to reach us is a call or text. You'll talk to a real person who can schedule you today.</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href={telHref}>Call {b.phoneDisplay}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <h2>Prefer to Send Details?</h2>
        {b.forms.accessKey ? (
          <form class="quote-form" action="https://api.web3forms.com/submit" method="POST">
            {/* Web3Forms: no JavaScript, no third-party script, plain POST.
                Submissions email the address the access key was issued to. */}
            <input type="hidden" name="access_key" value={b.forms.accessKey} />
            <input type="hidden" name="subject" value={`New estimate request from ${b.name}`} />
            <input type="hidden" name="from_name" value={b.name} />
            {b.forms.redirectUrl && <input type="hidden" name="redirect" value={b.forms.redirectUrl} />}
            {/* Honeypot: bots fill it, humans never see it. */}
            <input type="checkbox" name="botcheck" class="quote-form__botcheck" tabindex="-1" autocomplete="off" />

            <label class="quote-form__label" for="qf-name">Your name</label>
            <input class="quote-form__input" id="qf-name" type="text" name="name" autocomplete="name" required />

            <label class="quote-form__label" for="qf-phone">Phone</label>
            <input class="quote-form__input" id="qf-phone" type="tel" name="phone" autocomplete="tel" required />

            <label class="quote-form__label" for="qf-message">What do you need done?</label>
            <textarea class="quote-form__input" id="qf-message" name="message" rows="4" placeholder="Example: tall pine leaning toward the house, off Longmire" required></textarea>

            <button class="btn btn--primary quote-form__submit" type="submit">Request My Free Estimate</button>
            <p class="quote-form__note">Estimate requests get answered the same day. If a tree is already on a structure, call instead so it gets scheduled faster.</p>
          </form>
        ) : (
          <div class="gbp-embed-placeholder">
            [PENDING: quote form. Get a free access key at web3forms.com, then
            set forms.accessKey in business.ts to switch this on.]
          </div>
        )}
      </div>
      <div>
        <h2>What Happens Next</h2>
        <p>
          Call or text {b.phoneDisplay} any day of the week and tell us what the
          tree is doing: leaning, dropping limbs, crowding the roof, or already
          down. You get a free estimate for the work, in writing, with the
          removal, hauling, and cleanup spelled out before anything goes on the
          schedule. Storm damage jumps the line, so say so if a tree is on a
          structure or blocking your driveway.
        </p>
      </div>
    </div>
  </section>

  <MapNAP />
</BaseLayout>
