---
/**
 * CONTACT PAGE, phone-first (Rule 21: primary CTA = fastest path to a
 * call). Form has the MINIMUM possible fields (Rule 13) and is a
 * placeholder shell: wire the action/embed to the GHL form + pipeline
 * per business at fill-in time. Quote submissions auto-forward per the
 * lead-routing setup.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MapNAP from '../components/MapNAP.astro';
import { business as b, cityState, telHref } from '../config/business';

const title = `Contact ${b.name} | ${b.primaryCategory} in ${cityState}`;
const description = `Call ${b.name} or send a quick request online. Free estimates for tree removal, trimming, stump grinding, and storm cleanup in ${cityState}.`;

/**
 * Share card for THIS PAGE ONLY (og: + twitter:), passed through BaseLayout's
 * `social` prop because meta tags have to land in <head> — anything rendered
 * from the slot below ends up in <body>, where scrapers ignore it.
 * This is what people see when the page is texted or posted, so it reads as an
 * invitation rather than as the search-results title. `title` and `description`
 * above still drive <title> and meta description untouched, so nothing here
 * can move Google rankings. og:/twitter:description fall through to
 * `description`.
 */
const social = {
  title: 'Book Your Free Appointment',
  url: 'https://www.conroetreeco.com/contact/',
  image: 'https://www.conroetreeco.com/images/estimate-preview.jpg',
};
---

<BaseLayout title={title} description={description} social={social}>
  <section class="hero">
    <div class="container">
      <h1>Get a Fast, Free Estimate in {b.address.city}</h1>
      <p class="hero__sub">Call now and talk to a real person, or book a time below that fits your schedule. Either way the estimate is free and the price is in writing before any work starts.</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href={telHref}>Call Now</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        {/* GHL (LeadConnector) quote form. No `height:100%` on the iframe
            and no fixed height on the wrapper: form_embed.js writes the
            loaded form's real height onto iframe.style.height, and the
            auto-height wrapper hugs it. A taller/shorter form in GHL then
            updates the page by itself -- nothing to touch here. */}
        <div class="quote-form-embed">
          <iframe
            src="https://api.leadconnectorhq.com/widget/form/lVpPEmDHvnyLuJHiyCIS"
            style="width:100%;border:none;border-radius:8px"
            id="inline-lVpPEmDHvnyLuJHiyCIS"
            data-layout="{'id':'INLINE'}"
            data-trigger-type="alwaysShow"
            data-trigger-value=""
            data-activation-type="alwaysActivated"
            data-activation-value=""
            data-deactivation-type="neverDeactivate"
            data-deactivation-value=""
            data-form-name="Form 0"
            data-height="1024"
            data-layout-iframe-id="inline-lVpPEmDHvnyLuJHiyCIS"
            data-form-id="lVpPEmDHvnyLuJHiyCIS"
            data-cookie-consent="true"
            data-cookie-consent-provider="auto"
            title="Form 0"
          ></iframe>
        </div>
      </div>
      <div>
        {/* GHL (LeadConnector) booking calendar, the second column of the
            same .split grid: on desktop it sits directly beside the form,
            below it on tablet and phone. Same auto-height contract as the
            form -- form_embed.js writes the widget's real height onto
            iframe.style.height, so the wrapper is `height: auto` and the
            CSS height is only the pre-load placeholder. */}
        <div class="booking-embed">
          <iframe
            src="https://api.leadconnectorhq.com/widget/booking/6xy0znQhsIGbBYFRhAqR"
            allow="payment"
            scrolling="no"
            style="width:100%;border:none;overflow:hidden;border-radius:8px"
            id="6xy0znQhsIGbBYFRhAqR_1790200366596"
            title="Book an appointment"
          ></iframe>
        </div>
      </div>
    </div>
    {/* One script for BOTH embeds -- form_embed.js resizes every LeadConnector
        iframe on the page, so loading it a second time would only duplicate
        the listeners. */}
    <script is:inline src="https://link.msgsndr.com/js/form_embed.js"></script>
  </section>

  <MapNAP />
</BaseLayout>
