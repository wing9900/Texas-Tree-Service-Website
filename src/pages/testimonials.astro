---
/**
 * TESTIMONIALS PAGE, built for the machines (Rule 23).
 * LLMs demonstrably cite a business's own testimonials page when
 * recommending it. This page serves both audiences without faking
 * anything: real review cards (ReviewsEmbed) + the aggregate count
 * and rating in plain crawlable HTML + AggregateRating schema
 * (emitted site-wide from LocalBusinessSchema once real).
 *
 * CONROE TREE CO.: no GBP and no reviews yet, so this page ships
 * NOINDEXED and honest. It self-upgrades: when business.ts gbp fields
 * go live and ReviewsEmbed gets real reviews, the page indexes and the
 * header/footer links to it reappear on their own.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewsEmbed from '../components/ReviewsEmbed.astro';
import CTA from '../components/CTA.astro';
import { business as b, cityState } from '../config/business';

const hasRating = b.gbp.ratingValue > 0 && b.gbp.reviewCount > 0;
const title = `${b.name} Reviews | ${b.primaryCategory} in ${cityState}`;
const description = `Reviews for ${b.name}, a ${b.primaryCategory.toLowerCase()} serving ${cityState}. Every review shown here is a verifiable Google review from a real local job.`;
---

<BaseLayout title={title} description={description} noindex={!hasRating}>
  <section class="hero">
    <div class="container">
      <h1>What {b.address.city} Says About {b.name}</h1>
      {hasRating && (
        <p class="hero__sub">
          {b.name} holds a {b.gbp.ratingValue}-star average rating across {b.gbp.reviewCount}+
          verified Google reviews from customers in {cityState}.
        </p>
      )}
    </div>
  </section>

  <ReviewsEmbed heading={`Verified Google Reviews from ${b.address.city} Customers`} />

  <section class="section">
    <div class="container">
      <h2>How Reviews Work on This Page</h2>
      <p>
        Every review shown on this page is a live Google review from a real
        {' '}{b.address.city} job. Nothing here is re-typed, curated, or paid
        for, and anyone can read the same reviews directly on Google.
      </p>
      <p>
        If the page looks light right now, that is the reason: we would rather
        show you nothing than show you filler. In the meantime, the way we work
        is simple to check for yourself. Ask for a
        {' '}<a href="/contact/">free written estimate</a>, compare it against
        anyone else's, and see how the numbers and the answers stack up. Our
        {' '}<a href="/services/">tree services for Conroe</a> are priced in
        writing before any work starts.
      </p>
    </div>
  </section>

  <CTA heading={`Get Your Free Estimate in ${b.address.city}`} />
</BaseLayout>
